def grammar.control.match_length_allows
  (first : input_types.Cursor) (second : input_types.Cursor)
  (allow_equal : Bool) :
  Result Bool
  := do
  if first.byte > second.byte
  then ok true
  else
    if first.byte = second.byte
    then
      if first.bit > second.bit
      then ok true
      else if allow_equal
           then ok (first.bit = second.bit)
           else ok false
    else ok false

