def sign_extend (value : Std.U64) (width : Std.U8) : Result Std.I64 := do
  if width = 0#u8
  then ok 0#i64
  else
    let i ← width - 1#u8
    let sign ← 1#u64 <<< i
    if value < sign
    then ok (UScalar.hcast .I64 value)
    else
      let i1 ← sign - 1#u64
      let i2 ← value - sign
      let complement ← i1 - i2
      let i3 ← lift (UScalar.hcast .I64 complement)
      (-1)#i64 - i3

