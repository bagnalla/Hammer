def span_types.span_cursor_valid
  (length : Std.Usize) (cursor : input_types.Cursor) : Result Bool := do
  if cursor.bit < 8#u8
  then
    if cursor.byte < length
    then ok true
    else if cursor.byte = length
         then ok (cursor.bit = 0#u8)
         else ok false
  else ok false

