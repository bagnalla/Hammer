      if value >= i
      then ok (core.result.Result.Err ConfigError.InvalidLiteral)
      else ok (core.result.Result.Ok { bits, value })
    else ok (core.result.Result.Ok { bits, value })
  | core.result.Result.Err error => ok (core.result.Result.Err error)

