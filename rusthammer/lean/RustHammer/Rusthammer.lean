    else
      if cursor.byte = length
      then
        if cursor.bit != 0#u8
        then ok (some ParseError.InvalidCursor)
        else
          if cursor.bit != 0#u8
          then ok (some ParseError.Unaligned)
          else ok none
      else
        if cursor.bit != 0#u8
        then ok (some ParseError.Unaligned)
        else ok none

