def scope_boundary_error
  (length : Std.Usize) (cursor : Cursor) : Result (Option ParseError) := do
  if cursor.bit >= 8#u8
  then ok (some ParseError.InvalidCursor)
  else
    if cursor.byte > length
    then ok (some ParseError.InvalidCursor)
    else
      if cursor.byte = length
      then
        if cursor.bit != 0#u8
        then ok (some ParseError.InvalidCursor)
        else
          if cursor.bit != 0#u8
          then ok (some ParseError.Unaligned)
          else ok none
      else
        if cursor.bit != 0#u8
        then ok (some ParseError.Unaligned)
        else ok none

