def repeat_cursor_valid
  (input : Slice Std.U8) (cursor : Cursor) : Result Bool := do
  if cursor.bit < 8#u8
  then
    let i := Slice.len input
    if cursor.byte < i
    then ok true
    else
      let i1 := Slice.len input
      if cursor.byte = i1
      then ok (cursor.bit = 0#u8)
      else ok false
  else ok false

